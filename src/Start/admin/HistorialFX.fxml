<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity"
           minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="560.0" prefWidth="1117.0"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Start.admin.HistorialController">

   <children>

      <!-- FONDO -->
      <Pane prefHeight="560.0" prefWidth="1117.0">
         <children>
            <ImageView fitHeight="560.0" fitWidth="1117.0"
                       mouseTransparent="true"
                       pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/Shared/2%20Venta/Fondo.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="100.0" fitWidth="1117.0"
                       mouseTransparent="true"
                       pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/Shared/2%20Venta/Barra.png" />
               </image>
            </ImageView>
         </children>
      </Pane>

      <!-- CONTENIDO -->
      <Pane prefHeight="560.0" prefWidth="1117.0">
         <children>

            <!-- TITULO -->
            <Text layoutX="30.0" layoutY="120.0"
                  strokeType="OUTSIDE" strokeWidth="0.0"
                  text="Historial de Compras">
               <font>
                  <Font name="Montserrat Black" size="22.0" />
               </font>
            </Text>

            <!-- LISTA -->
            <ListView fx:id="listaHistorial"
                      layoutX="30.0" layoutY="140.0"
                      prefHeight="350.0" prefWidth="1057.0" />

            <!-- BOTON VOLVER -->
            <Button layoutX="30.0" layoutY="510.0"
                    mnemonicParsing="false"
                    onAction="#volver"
                    prefHeight="35.0" prefWidth="120.0"
                    text="Volver" />

         </children>
      </Pane>

      <!-- OVERLAY -->
      <Pane fx:id="overlay"
            mouseTransparent="true" opacity="0.0"
            prefHeight="560.0" prefWidth="1117.0"
            style="-fx-background-color: black;" />

   </children>

</StackPane>